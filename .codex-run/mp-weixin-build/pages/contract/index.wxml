<view class="page"><view class="tabs"><view wx:for="{{a}}" wx:for-item="item" wx:key="b" class="{{['tab', item.c && 'active']}}" bindtap="{{item.d}}">{{item.a}}</view></view><view wx:if="{{b}}" class="empty">暂无合同信息</view><view wx:for="{{c}}" wx:for-item="item" wx:key="g" class="card" bindtap="{{item.h}}"><view class="row"><text class="title">{{item.a}}</text><text class="{{['badge', item.c]}}">{{item.b}}</text></view><text class="meta">合同编号：{{item.d}}</text><text class="meta">服务人员：{{item.e}}</text><text class="meta">签署时间：{{item.f}}</text></view><view wx:if="{{d}}" class="sheet"><view class="sheet-card"><view class="row"><text class="title">{{e}}</text><text class="close" bindtap="{{f}}">关闭</text></view><text class="meta">合同编号：{{g}}</text><text class="meta">服务人员：{{h}}</text><text class="meta">服务类型：{{i}}</text><text class="meta">关联需求：{{j}}</text><text class="meta">关联订单：{{k}}</text><view class="file-card"><view class="file-icon">{{l}}</view><view class="file-info"><text class="file-title">{{m}}</text><text class="file-desc">{{n}}</text></view></view><button class="primary" bindtap="{{o}}">打开合同文件</button></view></view></view>