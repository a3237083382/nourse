<view wx:if="{{a}}" class="page"><view class="panel"><view class="row"><text class="title">{{b}}</text><text class="status">{{c}}</text></view><text class="meta">{{d}} · {{e}} {{f}}</text><text class="meta">跟进状态：{{g}}</text></view><view class="panel"><text class="section-title">需求信息</text><text class="line">联系人：{{h}}</text><text class="line">联系电话：{{i}}</text><text class="line">详细地址：{{j}}</text><text class="line">薪资待遇：{{k}}</text><text class="line">是否住家：{{l}}</text><text class="line">补充说明：{{m}}</text></view><view class="panel"><view class="row"><text class="section-title">推荐阿姨</text><text class="hint">{{n}} 位</text></view><view wx:if="{{o}}" class="empty">{{p}}</view><view wx:for="{{q}}" wx:for-item="item" wx:key="g" class="recommend" bindtap="{{item.h}}"><text class="recommend-name">{{item.a}}</text><text class="meta">{{item.b}} · {{item.c}} · {{item.d}}岁 · {{item.e}}年经验</text><text class="reason">推荐理由：{{item.f}}</text></view></view><button wx:if="{{r}}" class="cancel" bindtap="{{s}}">取消需求</button></view>