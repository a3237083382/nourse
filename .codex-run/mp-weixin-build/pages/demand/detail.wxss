.page{min-height:100vh;padding:24rpx;background:#f4f5f2}.panel{margin-bottom:22rpx;padding:28rpx;border:1px solid rgba(31,37,43,.05);border-radius:24rpx;background:#fff;box-shadow:0 12rpx 30rpx rgba(32,38,44,.05)}.row{display:flex;justify-content:space-between;gap:20rpx}.title,.section-title,.recommend-name{color:#20242c;font-weight:700}.title{font-size:34rpx}.section-title,.recommend-name{font-size:30rpx}.status,.hint{flex:0 0 auto;padding:6rpx 14rpx;border-radius:999rpx;background:#fff0f2;color:#d93f58;font-size:26rpx}.meta,.line,.reason,.empty{display:block;margin-top:14rpx;color:#6d7480;font-size:26rpx;line-height:1.7}.recommend{margin-top:18rpx;padding:22rpx;border-radius:20rpx;background:#f7f8f5}.empty{padding:30rpx 0;text-align:center}.cancel{height:84rpx;line-height:84rpx;border-radius:22rpx;background:#fff;color:#3b414c;font-size:28rpx}
