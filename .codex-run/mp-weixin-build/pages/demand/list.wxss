.page{min-height:100vh;padding:24rpx;background:#f4f5f2}.publish{margin-bottom:24rpx;height:84rpx;line-height:84rpx;border-radius:22rpx;background:#e84d64;color:#fff;font-size:30rpx;box-shadow:0 12rpx 26rpx rgba(232,77,100,.18)}.card{margin-bottom:20rpx;padding:28rpx;border:1px solid rgba(31,37,43,.05);border-radius:24rpx;background:#fff;box-shadow:0 12rpx 30rpx rgba(32,38,44,.05)}.row{display:flex;justify-content:space-between;gap:20rpx}.title{color:#20242c;font-size:30rpx;font-weight:700}.status{flex:0 0 auto;padding:6rpx 14rpx;border-radius:999rpx;background:#fff0f2;color:#d93f58;font-size:24rpx}.meta{display:block;margin-top:12rpx;color:#6d7480;font-size:26rpx}.empty{padding:90rpx 0;border-radius:24rpx;background:#fff;color:#8a8f99;text-align:center;font-size:28rpx}
