<view class="page"><scroll-view class="tabs" scroll-x><view wx:for="{{a}}" wx:for-item="tab" wx:key="b" class="{{['tab', tab.c && 'active']}}" bindtap="{{tab.d}}">{{tab.a}}</view></scroll-view><view wx:if="{{b}}" class="empty">暂无团购订单</view><view wx:for="{{c}}" wx:for-item="item" wx:key="i" class="order" bindtap="{{item.j}}"><view class="top"><text class="title">{{item.a}}</text><text class="status">{{item.b}}</text></view><view class="meta"><text>{{item.c}}</text><text>订单号 {{item.d}}</text></view><view class="bottom"><text class="amount">¥{{item.e}}</text><text wx:if="{{item.f}}" class="team">还差 {{item.g}} 人</text><text wx:else class="team">{{item.h}}</text></view></view><view wx:if="{{d}}" class="mask" bindtap="{{A}}"><view class="sheet" catchtap="{{z}}"><view class="sheet-head"><text class="sheet-title">订单详情</text><text class="close" bindtap="{{e}}">关闭</text></view><view class="line"><text>商品</text><text>{{f}}</text></view><view class="line"><text>订单号</text><text>{{g}}</text></view><view class="line"><text>购买方式</text><text>{{h}}</text></view><view class="line"><text>订单状态</text><text>{{i}}</text></view><view class="line"><text>实付金额</text><text>¥{{j}}</text></view><view class="line"><text>有效期至</text><text>{{k}}</text></view><view wx:if="{{l}}" class="team-card"><text class="team-title">拼团状态：{{m}}</text><text class="team-desc">当前 {{n}}/{{o}} 人，满员后自动成团。</text></view><view class="flow"><view wx:for="{{p}}" wx:for-item="step" wx:key="c" class="{{['flow-step', step.d && 'done']}}"><view class="flow-dot">{{step.a}}</view><text>{{step.b}}</text></view></view><view wx:if="{{q}}" class="review"><text class="review-title">用户评价</text><text class="stars">{{r}}</text><text class="review-content">{{s}}</text></view><view wx:elif="{{t}}" class="review"><text class="review-title">评价本次团购服务</text><view class="star-row"><text wx:for="{{v}}" wx:for-item="score" wx:key="a" class="{{['star', score.b && 'active']}}" bindtap="{{score.c}}">★</text></view><block wx:if="{{r0}}"><textarea class="review-input" maxlength="512" placeholder="写下团购服务体验，方便平台持续改进" value="{{w}}" bindinput="{{x}}"/></block><button class="review-button" bindtap="{{y}}">提交评价</button></view></view></view></view>