.page{min-height:100vh;padding:24rpx;background:#f4f5f2}.panel{margin-bottom:22rpx;padding:28rpx;border:1px solid rgba(31,37,43,.05);border-radius:24rpx;background:#fff;box-shadow:0 12rpx 30rpx rgba(32,38,44,.05)}.row{display:flex;justify-content:space-between;gap:16rpx}.title,.section-title{color:#20242c;font-weight:700}.title{font-size:34rpx}.section-title{display:block;margin-bottom:12rpx;font-size:30rpx}.status{flex:0 0 auto;padding:6rpx 14rpx;border-radius:999rpx;background:#fff0f2;color:#d93f58;font-size:26rpx}.meta,.line{display:block;margin-top:12rpx;color:#6d7480;font-size:26rpx;line-height:1.6}
