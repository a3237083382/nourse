<view class="page"><view wx:if="{{a}}" class="panel"><text class="title">预约 {{b}}</text><text class="meta">{{c}} · {{d}} {{e}}</text></view><view class="panel"><view class="field"><text class="label">联系人</text><input placeholder="请输入联系人" value="{{f}}" bindinput="{{g}}"/></view><view class="field"><text class="label">联系电话</text><input type="number" placeholder="请输入联系电话" value="{{h}}" bindinput="{{i}}"/></view><view class="field"><text class="label">期望面试时间</text><input placeholder="例如：本周六上午" value="{{j}}" bindinput="{{k}}"/></view><view class="field"><text class="label">面试方式</text><view class="segmented"><text wx:for="{{l}}" wx:for-item="item" wx:key="b" class="{{[item.c && 'active']}}" bindtap="{{item.d}}">{{item.a}}</text></view></view><view class="field"><text class="label">面试地址</text><input placeholder="线下面试可填写大致地址" value="{{m}}" bindinput="{{n}}"/></view><view class="field"><text class="label">服务重点</text><block wx:if="{{r0}}"><textarea maxlength="200" placeholder="简单写下希望重点沟通的服务内容" value="{{o}}" bindinput="{{p}}"/></block></view><view class="tip">提交后平台工作人员会线下联系你确认面试安排。</view></view><button class="submit" loading="{{q}}" bindtap="{{r}}">提交预约</button></view>