.page{min-height:100vh;padding:24rpx;background:#f4f5f2}.card,.empty{margin-bottom:22rpx;padding:28rpx;border:1px solid rgba(31,37,43,.05);border-radius:24rpx;background:#fff;box-shadow:0 12rpx 30rpx rgba(32,38,44,.05)}.empty,.meta{color:#6d7480;font-size:26rpx}.row{display:flex;justify-content:space-between;gap:16rpx}.title{color:#20242c;font-size:32rpx;font-weight:700}.status{flex:0 0 auto;padding:6rpx 14rpx;border-radius:999rpx;background:#fff0f2;color:#d93f58;font-size:26rpx}.meta{display:block;margin-top:12rpx;line-height:1.6}
