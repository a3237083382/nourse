<view class="page"><view class="profile-band"><view class="profile-row"><view class="avatar"><image wx:if="{{a}}" class="avatar-img" src="{{b}}" mode="aspectFill"/><view wx:else class="avatar-heart"></view></view><view class="profile-main"><text class="nickname">{{c}}</text><text wx:if="{{d}}" class="login-tip">登录后查看订单、需求和收藏</text><button wx:if="{{e}}" class="phone-login" open-type="getPhoneNumber" bindgetphonenumber="{{f}}"> 手机号快捷登录 </button></view><button class="setting-btn" bindtap="{{g}}"><text class="setting-dot"></text><text>设置</text></button></view></view><view class="order-card"><text class="card-title">我的订单</text><view class="order-grid"><view class="order-entry" bindtap="{{h}}"><view class="order-icon group-icon">团</view><text>团购订单</text></view><view class="order-entry" bindtap="{{i}}"><view class="order-icon service-icon">服</view><text>服务订单</text></view></view></view><view class="menu-card"><view wx:for="{{j}}" wx:for-item="item" wx:key="d" class="menu-item" bindtap="{{item.e}}"><view class="menu-left"><view class="{{['menu-icon', item.b]}}"><text>{{item.a}}</text></view><text class="menu-title">{{item.c}}</text></view><text class="chevron">›</text></view></view><button wx:if="{{k}}" class="logout" bindtap="{{l}}">退出登录</button></view>