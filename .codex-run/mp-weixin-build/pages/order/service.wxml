<view class="page"><view class="tabs"><view wx:for="{{a}}" wx:for-item="item" wx:key="b" class="{{['tab', item.c && 'active']}}" bindtap="{{item.d}}">{{item.a}}</view></view><view wx:if="{{b}}" class="empty">暂无服务订单</view><view wx:for="{{c}}" wx:for-item="item" wx:key="h" class="card" bindtap="{{item.i}}"><view class="row"><text class="title">{{item.a}}</text><text class="badge">{{item.b}}</text></view><text class="meta">订单号：{{item.c}}</text><text class="meta">服务人员：{{item.d}}</text><text class="meta">服务日期：{{item.e}} 至 {{item.f}}</text><text class="amount">¥{{item.g}}</text></view><view wx:if="{{d}}" class="sheet"><view class="sheet-card"><view class="row"><text class="title">{{e}}</text><text class="close" bindtap="{{f}}">关闭</text></view><text class="meta">订单号：{{g}}</text><text class="meta">服务人员：{{h}}</text><text class="meta">关联需求：{{i}}</text><text class="meta">服务日期：{{j}} 至 {{k}}</text><text class="meta">后台备注：{{l}}</text><view class="flow"><view wx:for="{{m}}" wx:for-item="step" wx:key="c" class="{{['flow-step', step.d && 'done']}}"><view class="flow-dot">{{step.a}}</view><text>{{step.b}}</text></view></view><view wx:if="{{n}}" class="review"><text class="review-title">用户评价</text><text class="stars">{{o}}</text><text class="review-content">{{p}}</text></view><view wx:elif="{{q}}" class="review"><text class="review-title">评价本次服务</text><view class="star-row"><text wx:for="{{r}}" wx:for-item="score" wx:key="a" class="{{['star', score.b && 'active']}}" bindtap="{{score.c}}">★</text></view><block wx:if="{{r0}}"><textarea class="review-input" maxlength="512" placeholder="写下这次服务体验，方便平台持续改进" value="{{s}}" bindinput="{{t}}"/></block><button class="review-button" bindtap="{{v}}">提交评价</button></view></view></view></view>