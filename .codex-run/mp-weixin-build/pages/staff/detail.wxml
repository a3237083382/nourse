<view wx:if="{{a}}" class="page"><image wx:if="{{b}}" class="cover" src="{{c}}" mode="aspectFill"/><view wx:else class="cover placeholder">{{d}}</view><view class="panel"><view class="name-row"><text class="name">{{e}}</text><text class="salary">¥{{f}}-{{g}}/{{h}}</text></view><view class="meta-pills"><text>{{i}}</text><text>{{j}} {{k}}</text><text>{{l}}岁</text><text>{{m}}年经验</text></view><view class="tags"><text wx:for="{{n}}" wx:for-item="tag" wx:key="b" class="tag">{{tag.a}}</text></view></view><view class="panel"><text class="section-title">服务说明</text><text class="paragraph">{{o}}</text></view><view class="panel"><text class="section-title">服务流程</text><view class="flow"><view wx:for="{{p}}" wx:for-item="item" wx:key="c" class="flow-step"><view class="flow-icon">{{item.a}}</view><text>{{item.b}}</text></view></view></view><view class="panel"><text class="section-title">平台核验</text><view class="trust-grid"><view wx:for="{{q}}" wx:for-item="item" wx:key="c" class="trust"><text class="trust-mark">✓</text><view><text class="trust-title">{{item.a}}</text><text class="trust-desc">{{item.b}}</text></view></view></view></view><view class="panel"><text class="section-title">证书</text><text wx:if="{{r}}" class="muted">暂无证书</text><view wx:for="{{s}}" wx:for-item="item" wx:key="b" class="line">{{item.a}}</view></view><view class="panel"><text class="section-title">照片</text><scroll-view wx:if="{{t}}" scroll-x><view class="photo-row"><image wx:for="{{v}}" wx:for-item="item" wx:key="a" class="photo" src="{{item.b}}" mode="aspectFill"/></view></scroll-view><text wx:else class="muted">暂无照片</text></view><view class="panel"><text class="section-title">工作经历</text><view wx:for="{{w}}" wx:for-item="item" wx:key="d" class="experience"><text class="period">{{item.a}} - {{item.b}}</text><text class="paragraph">{{item.c}}</text></view><text wx:if="{{x}}" class="muted">暂无经历</text></view><view class="panel"><view class="review-head"><text class="section-title">用户评价</text><text class="review-count">全部 {{y}}</text></view><text wx:if="{{z}}" class="muted">暂无评价~</text><view wx:for="{{A}}" wx:for-item="item" wx:key="d" class="review-item"><view class="review-top"><text class="review-user">{{item.a}}</text><text class="review-stars">{{item.b}}</text></view><text class="paragraph">{{item.c}}</text></view></view><view class="actions"><button bindtap="{{C}}">{{B}}</button><button open-type="share">分享</button><button open-type="contact">客服</button><button class="primary" bindtap="{{D}}">预约面试</button></view></view>